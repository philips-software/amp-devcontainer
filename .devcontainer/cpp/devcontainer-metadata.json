{
  "customizations": {
    "vscode": {
      "extensions": [
        "llvm-vs-code-extensions.vscode-clangd@0.6.0",
        "ms-vscode.cmake-tools@1.24.42",
        "ms-vscode.cpptools@1.35.6",
        "sonarsource.sonarlint-vscode@6.2.0"
      ],
      "settings": {
        "C_Cpp.intelliSenseEngine": "disabled",
        "clangd.arguments": [
          "--compile-commands-dir=${userHome}/.amp"
        ],
        "cmake.copyCompileCommands": "${userHome}/.amp/compile_commands.json",
        "sonarlint.pathToCompileCommands": "/home/code/.amp/compile_commands.json",
        "[c][cpp]": {
          "editor.defaultFormatter": "llvm-vs-code-extensions.vscode-clangd"
        }
      }
    }
  }
}
