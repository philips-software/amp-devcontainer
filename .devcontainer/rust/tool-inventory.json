{
  "includes": [
    "../base/tool-inventory.json"
  ],
  "packages": {
    "cargo-binstall": {
      "commands": ["cargo-binstall"],
      "smoke-test-args": { "cargo-binstall": ["--help"] }
    },
    "cargo-binutils": {
      "commands": [
        "rust-ar",
        "cargo-cov",
        "cargo-nm",
        "cargo-objcopy",
        "cargo-objdump",
        "cargo-profdata",
        "cargo-readobj",
        "cargo-size",
        "cargo-strip"
      ]
    },
    "cargo-mutants": {
      "commands": ["cargo-mutants"],
      "smoke-test-args": { "cargo-mutants": ["mutants", "--version"] }
    },
    "g++-15": {},
    "gdb-multiarch": { "commands": ["gdb", "gdb-multiarch"] },
    "rust": { "commands": ["rustc", "cargo", "rustfmt", "cargo-clippy"] },
    "rustup": {}
  }
}
